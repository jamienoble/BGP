# ---- Directus core -------------------------------------------------
# Generate each with: openssl rand -hex 32
KEY=
SECRET=
# The address staff will use, e.g. https://cms.yourdomain.co.uk
PUBLIC_URL=http://localhost:8055

# First admin account (created on first start; change the password after)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Database: Supabase -------------------------------------------
# Supabase dashboard > Connect > "Session pooler" (works over IPv4).
# Use the session pooler, not the transaction pooler. Copy the host from
# there: the region part (eu-west-2 below) depends on your project.
DB_CLIENT=pg
DB_HOST=aws-0-eu-west-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=postgres.cbanimdilwtfmouyfumr
DB_PASSWORD=
DB_SSL__REJECT_UNAUTHORIZED=false

# ---- File uploads: Supabase Storage -------------------------------
# Create a private bucket called "cms" in Supabase > Storage first.
STORAGE_LOCATIONS=supabase
STORAGE_SUPABASE_DRIVER=supabase
STORAGE_SUPABASE_PROJECT_ID=cbanimdilwtfmouyfumr
STORAGE_SUPABASE_BUCKET=cms
# Supabase > Project Settings > API > service_role key. Keep secret.
STORAGE_SUPABASE_SERVICE_ROLE=

# ---- Other ----------------------------------------------------------
# Not needed: staff edit through the web app, not live subscriptions
WEBSOCKETS_ENABLED=false
